msgstr "Подтвердить ✅"

msgid "Order placed! Total: ${total}"
msgstr "Заказ оформлен! Итого: ${total}"

msgid "Order cancelled"
msgstr "Заказ отменён"

msgid "(none)"
msgstr "(без топпингов)"

msgid "Cheese"
msgstr "Сыр"

